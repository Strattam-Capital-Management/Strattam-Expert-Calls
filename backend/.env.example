# Anthropic API key (Claude). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Firecrawl API key. https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# People Data Labs API key. https://www.peopledatalabs.com/
PDL_API_KEY=

# Grata API key (requires your account to be activated for API access by a Grata Customer
# Success Manager / Account Executive first - a plain seat login isn't enough). Used to ground
# competitor/similar-company research in structured data, and - if your plan includes the Data
# Warehouse / executive-contacts module - as a third candidate source. Leave empty to skip.
GRATA_API_KEY=

# Raylu API key. NOT YET USED by the pipeline - see clients/raylu.ts for why (their public docs
# don't expose a versioned REST API reference to build against yet; get the real contract from
# your Raylu account rep first). Safe to fill in now, has no effect until that file is finished.
RAYLU_API_KEY=

# Shared access code gating the whole app (no per-user accounts).
# Leave empty to disable auth entirely (LOCAL DEV ONLY - never leave empty in production).
ACCESS_CODE=

# Port the Express server listens on.
PORT=8787

# Path to the SQLite database file (directory is created automatically if missing).
DB_PATH=./data/sourcer.db

# How many days a cached CompanyProfile is considered fresh before re-researching.
CACHE_TTL_DAYS=30

# Comma-separated list of allowed origins for CORS in production, e.g.:
# CORS_ORIGINS=https://sourcer.strattam.com,https://sourcer-staging.strattam.com
# Leave empty to allow all origins (local dev only).
CORS_ORIGINS=

# Max concurrent People Data Labs requests in flight at once (PDL default rate limit is
# 10 requests/minute per key, so keep this modest).
PDL_CONCURRENCY=3

# Cost-estimate constants (ESTIMATED basis, not the firm's actual contracted rate - check
# against Strattam's real PDL/Firecrawl plan before trusting totals for budgeting).
PDL_COST_PER_RECORD_USD=0.28
FIRECRAWL_COST_PER_CALL_USD=0.012

# Grata is typically a seat/credit subscription, not metered pay-per-call - this is a rough
# per-call estimate for the cost breakdown only. Check against the firm's actual Grata contract.
GRATA_COST_PER_CALL_USD=0.05
